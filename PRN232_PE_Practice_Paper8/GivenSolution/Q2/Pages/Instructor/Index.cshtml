@page
@model Q2.Pages.Instructor.IndexModel
@{
}

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>Instructor Search</title>
</head>
<body>
    <div class="container search-wrapper">
        <h2>Instructor Search</h2>

        <form method="get" action="/Instructor">
            <div class="form-group">
                <label>Instructor Name:</label>
                <input type="text" name="name" id="ip_instructorName" placeholder="Nguyen Van A" value="@Model.Name">
            </div>

            <div class="form-group">
                <label>Department:</label>
                <input type="text" name="department" id="ip_department" placeholder="Software Engineering" value="@Model.Department">
            </div>

            <button type="submit" id="bt_search" class="btn-search">Search</button>
        </form>

        <table class="instructor-table" border="1" cellpadding="6" cellspacing="0">
            <thead>
                <tr>
                    <th>Instructor Name</th>
                    <th>Department</th>
                    <th>Hire Date</th>
                    <th>Total Courses</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var i in Model.Instructors)
            {
                <tr>
                    <td id="td_instructorName_@i.InstructorId">
                        @i.InstructorName
                    </td>

                    <td id="td_department_@i.InstructorId">
                        @i.Department
                    </td>

                    <td id="td_hireDate_@i.InstructorId">
                        @(i.HireDate.HasValue ? i.HireDate.Value.ToString("yyyy-MM-dd") : "")
                    </td>

                    <td id="td_totalCourses_@i.InstructorId">
                        @i.TotalCourses
                    </td>
                    <td>
                        <a href="/Instructor/@i.InstructorId" id="a_@i.InstructorId">
                            View Courses
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</body>
</html>
